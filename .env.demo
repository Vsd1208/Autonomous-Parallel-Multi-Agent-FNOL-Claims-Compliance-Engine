# Reproducible demo: deterministic mock vision, no API key needed.
#   docker compose --env-file .env.demo up -d --build
#   bash demo-scenarios/run-all.sh
GEMINI_VISION_ENABLED=false
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# STP-eligible claims are pre-filed and wait for an adjuster confirmation.
FNOL_STP_REQUIRE_ADVISORY_REVIEW=true

# Demo-only shared secret for the adjuster endpoints. It is baked into the console bundle,
# so it is not a real secret: change it, and use real adjuster authentication beyond a demo.
FNOL_ADJUSTER_TOKEN=demo-adjuster-token

MOCK_GW_TIMEOUT=false
MOCK_PC_TIMEOUT=false
MOCK_CC_START_SEQUENCE=1
