POSTGRES_DB=fnol
POSTGRES_USER=fnol
POSTGRES_PASSWORD=change-me
MOCK_GUIDEWIRE_BASE_URL=http://mock-guidewire:9090
VITE_API_BASE_URL=http://localhost:8080

# Gemini Vision AI (Branch A — Operational AI damage photo analysis)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# true: real vision AI (needs GEMINI_API_KEY). false: deterministic MockVisionProvider (see .env.demo)
GEMINI_VISION_ENABLED=true
GEMINI_VISION_MODEL=gemini-2.5-flash
# https hosts the API may download evidence photos from (comma-separated). Empty = data: URIs only.
FNOL_EVIDENCE_ALLOWED_HOSTS=

# People sign in to the workspace: id|ROLE|password|Display Name;... ROLE is ADJUSTER, SENIOR_ADJUSTER, SUPERVISOR or INSPECTOR.
FNOL_USERS=ADJ-001|ADJUSTER|change-me|An Adjuster;INS-101|INSPECTOR|change-me|An Inspector
# Service credential for integrations and scripts (X-Adjuster-Token). Empty rejects them. It is in no browser bundle.
FNOL_ADJUSTER_TOKEN=change-me
# Shared secret that signs claim events (claims system -> AI extension), HMAC-SHA256. Set the same value on both.
CLAIMS_EVENT_SECRET=change-me
# Adjuster workspace and policyholder portal
FNOL_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Upload links sent to claimants open the portal
FNOL_PORTAL_BASE_URL=http://localhost:5174

# true: STP-eligible claims wait as PENDING_ADVISORY_REVIEW for an adjuster. false: auto-filed.
FNOL_STP_REQUIRE_ADVISORY_REVIEW=true

# Mock Guidewire failure switches
MOCK_GW_TIMEOUT=false
MOCK_PC_TIMEOUT=false
MOCK_CC_START_SEQUENCE=1
