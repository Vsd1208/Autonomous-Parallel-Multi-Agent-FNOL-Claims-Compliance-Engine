# Lite mode for a quick review: recorded model answers, no vision-ml service, no model downloads, no key.
#   docker compose --env-file .env.lite -f docker-compose.yml -f docker-compose.lite.yml up -d --build
#   bash demo-scenarios/run-all.sh
GEMINI_VISION_ENABLED=false
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# STP-eligible claims are pre-filed and wait for an adjuster confirmation.
FNOL_STP_REQUIRE_ADVISORY_REVIEW=true

# Demo-only sign-ins for the workspace: not real secrets. Change them beyond a demo.
FNOL_USERS=ADJ-001|ADJUSTER|demo-password|Demo Adjuster;ADJ-002|ADJUSTER|demo-password|Second Adjuster;SEN-001|SENIOR_ADJUSTER|demo-password|Demo Senior Adjuster;SUP-001|SUPERVISOR|demo-password|Demo Supervisor;INS-101|INSPECTOR|demo-password|Inspector A;INS-102|INSPECTOR|demo-password|Inspector B;INS-201|INSPECTOR|demo-password|Inspector C;INS-301|INSPECTOR|demo-password|Partner Body Shop

# Demo-only service credential, for run-all.sh and other scripts.
FNOL_ADJUSTER_TOKEN=demo-adjuster-token

# Demo-only secret that signs claim events from the claims system to the AI extension.
CLAIMS_EVENT_SECRET=demo-event-secret

MOCK_GW_TIMEOUT=false
MOCK_PC_TIMEOUT=false
MOCK_CC_START_SEQUENCE=1

# Refuses to start with Gemini enabled: photo blurring is not available without vision-ml.
FNOL_LITE_MODE=true
