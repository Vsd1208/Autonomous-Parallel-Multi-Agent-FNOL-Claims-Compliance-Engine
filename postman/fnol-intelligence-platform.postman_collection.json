{
  "info": {
    "name": "FNOL Intelligence Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API Health",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/api/v1/health"
      }
    },
    {
      "name": "Mock Policy",
      "request": {
        "method": "GET",
        "url": "http://localhost:9090/pc/policies/POL-AUTO-112233"
      }
    },
    {
      "name": "Mock Coverages",
      "request": {
        "method": "GET",
        "url": "http://localhost:9090/pc/policies/POL-AUTO-112233/coverages"
      }
    },
    {
      "name": "Mock History",
      "request": {
        "method": "GET",
        "url": "http://localhost:9090/pc/policies/POL-AUTO-112233/history"
      }
    },
    {
      "name": "Create Mock Claim",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:9090/cc/claims",
        "body": {
          "mode": "raw",
          "raw": "{\"policyNumber\":\"POL-AUTO-112233\",\"incidentDate\":\"2026-08-16\",\"state\":\"CA\",\"estimatedDamage\":4200,\"reserve\":4830}"
        }
      }
    },
    {
      "name": "Get Mock Claim",
      "request": {
        "method": "GET",
        "url": "http://localhost:9090/cc/claims/{{claimId}}"
      }
    },
    {
      "name": "FNOL Intake",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Adjuster-Token",
            "value": "{{adjusterToken}}"
          }
        ],
        "url": "http://localhost:8080/api/v1/fnol/intake",
        "body": {
          "mode": "raw",
          "raw": "{\"policyNumber\": \"POL-AUTO-112233\", \"incidentDate\": \"2026-08-16\", \"state\": \"CA\", \"description\": \"Rear-ended by other driver. Police report filed.\", \"claimantName\": \"Avery Johnson\", \"claimantDob\": \"01/02/1980\", \"claimantSsn\": \"123-45-6789\", \"evidenceUris\": [\"mock://photo/normal-front-bumper.jpg\"], \"channel\": \"API\"}"
        }
      }
    },
    {
      "name": "FNOL Status",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/api/v1/fnol/status/{{claimId}}",
        "header": [
          {
            "key": "X-Adjuster-Token",
            "value": "{{adjusterToken}}"
          }
        ]
      }
    },
    {
      "name": "Update Mock Claim",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:9090/cc/claims/{{claimId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"status\": \"APPROVED_BY_ADJUSTER\", \"notes\": \"Photos match.\"}"
        }
      }
    },
    {
      "name": "Attach Document to Mock Claim",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:9090/cc/claims/{{claimId}}/attachments",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"note.json\", \"contentType\": \"application/json\", \"body\": {\"text\": \"example\"}}"
        }
      }
    },
    {
      "name": "FNOL Explanation (WHY panel)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Adjuster-Token",
            "value": "{{adjusterToken}}"
          }
        ],
        "url": "http://localhost:8080/api/v1/fnol/{{claimId}}/explanation"
      }
    },
    {
      "name": "FNOL Audit Trail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Adjuster-Token",
            "value": "{{adjusterToken}}"
          }
        ],
        "url": "http://localhost:8080/api/v1/fnol/{{claimId}}/audit"
      }
    },
    {
      "name": "FNOL Audit PDF",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Adjuster-Token",
            "value": "{{adjusterToken}}"
          }
        ],
        "url": "http://localhost:8080/api/v1/fnol/{{claimId}}/audit/pdf"
      }
    },
    {
      "name": "FNOL Adjuster Review",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Adjuster-Token",
            "value": "{{adjusterToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/api/v1/fnol/{{claimId}}/review",
        "body": {
          "mode": "raw",
          "raw": "{\"decision\": \"APPROVED_BY_ADJUSTER\", \"adjusterId\": \"ADJ-001\", \"notes\": \"Reviewed WHY factors.\"}"
        }
      }
    },
    {
      "name": "FNOL Adjuster Queue",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Adjuster-Token",
            "value": "{{adjusterToken}}"
          }
        ],
        "url": "http://localhost:8080/api/v1/fnol/queue?status=HUMAN_REVIEW,PENDING_ADVISORY_REVIEW&page=0&size=20"
      }
    }
  ],
  "variable": [
    {
      "key": "adjusterToken",
      "value": "demo-adjuster-token"
    },
    {
      "key": "claimId",
      "value": "CLM-2026-000001"
    }
  ]
}